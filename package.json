{
  "name": "agent-receipts",
  "version": "0.1.0",
  "private": true,
  "description": "See what your coding agent did, step by step and agent by agent, and rewind your files to any step.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-receipts": "./dist/cli.js"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "simulate": "node ./dist/cli.js simulate",
    "view": "node ./dist/cli.js view"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@openai/mcp-extensions": "0.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@types/node": "^22.19.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
